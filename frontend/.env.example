# Stytch B2B public token (dashboard > API keys). Safe to ship to the browser.
# Leave empty to boot the UI without auth (backend must have AUTH_ENABLED=false).
VITE_STYTCH_PUBLIC_TOKEN=

# API origin the UI calls. Default: http://<current host>:8000.
# Set to an empty string for same-origin (behind a reverse proxy).
# VITE_API_BASE=http://127.0.0.1:8000
