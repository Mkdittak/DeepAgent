# Required: Google API key for the Deep Agent (gemini-3.5-flash)
GOOGLE_API_KEY=your-google-api-key-here

# Required: Tavily API key for web search tool (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Temporal server address (default: localhost:7233)
TEMPORAL_ADDRESS=localhost:7233

# Base directory for artifact storage (default: ./artifacts)
ARTIFACT_BASE=./artifacts

# --- Auth (Stytch B2B) -------------------------------------------------------
# Feature flag. "false" (default) = single implicit user, no auth, byte-identical
# to pre-auth behavior. Flip to "true" once the Stytch keys below are filled in.
AUTH_ENABLED=false
# From the Stytch dashboard (B2B project, Test environment). Server-side only.
STYTCH_PROJECT_ID=
STYTCH_SECRET=
# "test" or "live". Must match the project the keys belong to.
STYTCH_ENV=test

# --- Artifacts / quotas (used when AUTH_ENABLED=true) -------------------------
# HMAC key for short-lived signed artifact links. Unset = random per process
# (links stop working across restarts). Set any long random string.
ARTIFACT_SIGNING_SECRET=
# Lifetime of a signed artifact link, seconds (default 60).
ARTIFACT_SIGN_TTL_SECS=60
# Max runs per organization per calendar day (default 100). Over cap -> 429.
RUN_QUOTA_PER_ORG_PER_DAY=100
# Agent step budget per run (default 15; was 30 before auth).
AGENT_RECURSION_LIMIT=15
